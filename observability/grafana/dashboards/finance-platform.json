        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Alertas activas",
      "description": "Alertas de Prometheus en estado firing. Detalle en http://localhost:9093.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
