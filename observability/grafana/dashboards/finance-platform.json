{
  "uid": "finance-platform",
  "title": "Finance Platform",
  "description": "Salud de la API de Finance Platform en Kubernetes.",
  "tags": [
    "finance-platform",
    "opendays"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 20,
      "type": "row",
      "title": "SLO — ¿los usuarios están bien?",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Disponibilidad (1 h) · SLO 99 %",
      "description": "Solicitudes de usuarios sin error 5xx en la última hora. Meta: 99 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sli:availability:ratio_rate1h * 100",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Presupuesto de error restante (1 h)",
