# Plantilla: al iniciar, la imagen de Nginx reemplaza ${VARIABLES} de entorno
# y genera /etc/nginx/conf.d/default.conf.
#
#   OTEL_TRACE              on | off   (trazas de Nginx)
#   OTEL_EXPORTER_ENDPOINT  host:4317  (Jaeger por OTLP/gRPC)
#   OTLP_HTTP_COLLECTOR     http://host:4318 (destino de las trazas del navegador)
#   NGINX_LOCAL_RESOLVERS   DNS del contenedor (lo calcula la imagen)

log_format finance_platform '$remote_addr - $remote_user [$time_local] "$request" '
                            '$status $body_bytes_sent "$http_referer" '
                            '"$http_user_agent" request_time=$request_time '
                            'upstream_time=$upstream_response_time trace_id=$otel_trace_id';

otel_exporter {
    endpoint ${OTEL_EXPORTER_ENDPOINT};
}
otel_service_name finance-nginx;

# Los health checks no generan trazas: solo serían ruido en Jaeger.
map $uri $otel_api_trace {
    ~^/api/(health|metrics)$  off;
    default                   ${OTEL_TRACE};
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log finance_platform;
    error_log /var/log/nginx/error.log warn;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        # Continúa la traza que empezó el navegador (encabezado traceparent)
        # y la pasa a la API.
        otel_trace $otel_api_trace;
        otel_trace_context propagate;
        otel_span_name "$request_method $uri";

        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    # Las trazas del navegador llegan aquí y se reenvían a Jaeger. El destino
    # se resuelve en cada solicitud: si Jaeger no existe, Nginx arranca igual.
    location = /v1/traces {
        access_log off;
        client_max_body_size 64k;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $otlp_collector ${OTLP_HTTP_COLLECTOR};
        proxy_pass $otlp_collector;
        proxy_connect_timeout 2s;
    }

    location = /health/frontend {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"frontend"}\n';
    }
}
